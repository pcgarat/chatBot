# Opcional: URL de Ollama (por defecto http://localhost:11434)
# OLLAMA_HOST=http://localhost:11434

# Opcional: ruta de la base de datos SQLite
# DATABASE_URL=sqlite:///./chatbot.db

# Número de pares (user+assistant) de historial a enviar a Ollama. Por defecto 10.
# OLLAMA_HISTORY_TURNS=10

# RAG con ChromaDB: embeddings con Ollama por defecto (ver RAG_CHROMADB_CHECKLIST.md)
# CHROMA_HOST por defecto es http://localhost:8001
# CHROMA_HOST=http://localhost:8001
# Modelo de embeddings en Ollama (por defecto mxbai-embed-large:latest). Haz: ollama pull mxbai-embed-large
# OLLAMA_EMBEDDING_MODEL=mxbai-embed-large:latest
# Opcional: usar OpenAI para embeddings (poner key en .env, no subir a git). Si cambias de proveedor, haz make chroma-clean y make chroma-up.
# EMBEDDINGS_PROVIDER=openai
# OPENAI_API_KEY=sk-...
